 src/ndp.c    | 207 ++++++++++++++++++++++++++++++++++++++++++++++++---
 src/odhcpd.c |  96 +++++++++++++++++++++++-
 src/odhcpd.h |  18 +++++
 4 files changed, 319 insertions(+), 13 deletions(-)

