+
+/** define a structure to initialize packet socket for rmnet interfaces */
+struct ipv6_mreq_test {
+	/* IPv6 multicast address group */
+	struct in6_addr ipv6mr_multicast;
+
+	/* ifindex of the interface */
+	int ipv6mr_ifindex;
+};
+
+#define ALL_HOSTS_MGROUP "FF02::1"
+#define ALL_ROUTERS_MGROUP "FF02::2"
+#define ALL_ROUTERS_MLD2 "FF02::16"
