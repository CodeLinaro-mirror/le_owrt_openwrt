+static struct in6_addr all_routers_in6_addr;
+static struct in6_addr all_mld2_routers_in6_addr;
+static struct in6_addr all_hosts_in6_addr;
+
 /* Filter ICMPv6 messages of type neighbor soliciation */
 static struct sock_filter bpf[] = {
 	BPF_STMT(BPF_LD | BPF_B | BPF_ABS, offsetof(struct ip6_hdr, ip6_nxt)),
@@ -86,6 +95,11 @@ int ndp_setup_interface(struct interface *iface, bool enable)
 		iface->ndp_ping_fd = -1;
 	}
 
+	if (iface->ndp_fd >= 0) {
