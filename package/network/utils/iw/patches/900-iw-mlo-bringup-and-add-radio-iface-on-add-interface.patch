From 83fd5740dcc1dc2e7287320b8b69db9c43317fcd Mon Sep 17 00:00:00 2001
From: Kannan Saravanan <quic_kannsara@quicinc.com>
Date: Thu, 19 Dec 2024 07:42:14 +0530
Subject: [PATCH] iw-mlo-bringup-and-add-radio-iface-on-add-interface

---
 interface.c | 39 +++++++++++++++++++++++++++++++++++++--
 nl80211.h   |  2 ++
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/interface.c b/interface.c
index 6876dcc..02d20ef 100644
--- a/interface.c
+++ b/interface.c
@@ -273,7 +273,10 @@ static int handle_interface_add(struct nl80211_state *state,
 	enum nl80211_iftype type;
 	int tpset;
 	unsigned char mac_addr[ETH_ALEN];
-	int found_mac = 0;
+	unsigned char mld_mac_addr[ETH_ALEN];
+	int found_mac = 0, found_mld_mac = 0, found_radio_iface = 0;
+	char mac_temp[20];
+	char *radioiface_name = NULL;
 
 	if (argc < 1)
 		return 1;
@@ -333,6 +336,28 @@ try_another:
 			}
 			argc--;
 			argv++;
+		} else if (strcmp(argv[0], "mld_addr") == 0) {
+			argc--;
+			argv++;
+			if (mac_addr_a2n(mld_mac_addr, argv[0])) {
+				fprintf(stderr, "Invalid MAC address\n");
+				return 2;
+			}
+			argc--;
+			argv++;
+			found_mld_mac = 1;
+			mac_addr_n2a(mac_temp, mld_mac_addr);
+			goto try_another;
+		} else if (strcmp(argv[0], "radio_iface") == 0) {
+			argc--;
+			argv++;
+
+			radioiface_name = argv[0];
+
+			argc--;
+			argv++;
+			found_radio_iface = 1;
+			goto try_another;
 		} else {
 			return 1;
 		}
@@ -347,12 +372,17 @@ try_another:
 		NLA_PUT(msg, NL80211_ATTR_MESH_ID, strlen(mesh_id), mesh_id);
 	if (found_mac)
 		NLA_PUT(msg, NL80211_ATTR_MAC, ETH_ALEN, mac_addr);
+	if (found_mld_mac)
+		NLA_PUT(msg, NL80211_ATTR_MLD_ADDR, ETH_ALEN, mld_mac_addr);
+
+	if (found_radio_iface)
+		NLA_PUT_STRING(msg, NL80211_ATTR_RADIO_IFACE, radioiface_name);
 
 	return 0;
  nla_put_failure:
 	return -ENOBUFS;
 }
-COMMAND(interface, add, "<name> type <type> [mesh_id <meshid>] [4addr on|off] [flags <flag>*] [addr <mac-addr>] [radios all|<id>[,<id>...]]",
+COMMAND(interface, add, "<name> type <type> [mesh_id <meshid>] [4addr on|off] [flags <flag>*] [addr <mac-addr>] [radio_iface] <iface-name>",
 	NL80211_CMD_NEW_INTERFACE, 0, CIB_PHY, handle_interface_add,
 	"Add a new virtual interface with the given configuration.\n"
 	IFACE_TYPES "\n\n"
@@ -598,6 +628,11 @@ static int print_iface_handler(struct nl_msg *msg, void *arg)
 		mac_addr_n2a(mac_addr, nla_data(tb_msg[NL80211_ATTR_MAC]));
 		printf("%s\taddr %s\n", indent, mac_addr);
 	}
+	if (tb_msg[NL80211_ATTR_MLD_ADDR]) {
+		char mld_mac_addr[20];
+		mac_addr_n2a(mld_mac_addr, nla_data(tb_msg[NL80211_ATTR_MLD_ADDR]));
+		printf("%s\tmld_addr %s\n", indent, mld_mac_addr);
+	}
 	if (tb_msg[NL80211_ATTR_SSID]) {
 		printf("%s\tssid ", indent);
 		print_ssid_escaped(nla_len(tb_msg[NL80211_ATTR_SSID]),
diff --git a/nl80211.h b/nl80211.h
index 39e0b4b..fb64b66 100644
--- a/nl80211.h
+++ b/nl80211.h
@@ -3468,6 +3468,8 @@ enum nl80211_attrs {
 
 	NL80211_ATTR_ADD_MULTI_CHAN,
 	NL80211_ATTR_DEL_MULTI_CHAN,
+	NL80211_ATTR_RADIO_IFACE = 350,
+
 	/* add attributes here, update the policy in nl80211.c */
 
 	__NL80211_ATTR_AFTER_LAST,
-- 
2.34.1

